# =============================================================================
# NQLabs Platform — .gitignore
# Public repo. NOTHING sensitive ever enters this file tree.
# When in doubt: put it in 1Password, not here.
# =============================================================================

# -----------------------------------------------------------------------------
# Talos
# -----------------------------------------------------------------------------
# Cluster secrets — generated by `talosctl gen secrets`
secrets.yaml
*.secret.yaml
*-secrets.yaml

# Generated machine configs with embedded secrets — scoped to generated/ dirs only
# (patches and templates in clusters/ are safe to commit)
**/generated/controlplane.yaml
**/generated/worker.yaml
**/generated/talosconfig
**/generated/kubeconfig

# Generated machine configs with embedded secrets (outside generated/ dirs)
**/bootstrap/talos/mgmt-*.yaml
**/bootstrap/talos/worker-*.yaml
# talosconfig at cluster root (not in generated/)
clusters/*/talosconfig

# -----------------------------------------------------------------------------
# Kubernetes
# -----------------------------------------------------------------------------
kubeconfig
*.kubeconfig
kube.config
.kube/

# -----------------------------------------------------------------------------
# 1Password / Secrets
# -----------------------------------------------------------------------------
1password-credentials.json
*.credentials.json
op.env

# -----------------------------------------------------------------------------
# Certificates & Keys
# -----------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.crt
# Allow: *.crt in docs/ if they are public CA roots
!docs/**/*.crt

# -----------------------------------------------------------------------------
# ArgoCD
# -----------------------------------------------------------------------------
# Never commit ArgoCD repo credentials or cluster secrets
argocd-secret.yaml
argocd-cluster-*.yaml

# -----------------------------------------------------------------------------
# Terraform / Tofu (future use)
# -----------------------------------------------------------------------------
*.tfstate
*.tfstate.*
*.tfvars
.terraform/
# Commit provider lock files for reproducible Terraform/OpenTofu runs.
!**/.terraform.lock.hcl

# -----------------------------------------------------------------------------
# Helm
# -----------------------------------------------------------------------------
# Never commit rendered Helm output
charts/*/charts/
*.tgz
# Helm chart pulls at repo root (helm pull --untar artifacts)
# Leading slash ensures these only match at the repo root, not subdirectories.
/cilium/
/coredns/
/falco/
/kube-prometheus-stack/
/loki/
/tailscale-operator/

# -----------------------------------------------------------------------------
# Environment files
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example

# -----------------------------------------------------------------------------
# OS / Editor
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Letta Code (agent working directory — local only)
# -----------------------------------------------------------------------------
.letta/

# -----------------------------------------------------------------------------
# Temporary / Local
# -----------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
clusters/lab/generated/
clusters/*/generated/
